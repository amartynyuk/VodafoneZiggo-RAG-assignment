# LLM & embeddings (OpenAI)
OPENAI_API_KEY=sk-...

# LangSmith observability
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
export LANGSMITH_API_KEY=lsv2_pt_...
export LANGSMITH_PROJECT="vziggo-rag"

# Model configuration
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5.6-luna

# Retrieval thresholds
CACHE_SIMILARITY_THRESHOLD=0.92
RAG_SIMILARITY_THRESHOLD=0.65

# Cache write-back (after successful RAG)
CACHE_AUTO_WRITE=true
CACHE_MIN_WRITE_CONFIDENCE=0.70

# BERT security gate (weights baked into the Docker image at build time)
SECURITY_ENABLED=true
SECURITY_TOXIC_THRESHOLD=0.5
SECURITY_OFFTOPIC_THRESHOLD=0.75

# Shared data directory (mounted volume in Docker)
DATA_DIR=/app/data

# Web app (browser → API)
VITE_API_URL=http://localhost:8000
